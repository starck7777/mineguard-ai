# Backend — local development defaults only
APP_ENV=development
DATABASE_URL=sqlite:///./backend/data/mineguard.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MINEGUARD_ADMIN_TOKEN=replace-with-a-long-random-local-value
MQTT_ENABLED=false
MODEL_PATH=

# Frontend — VITE_ values are public and must never contain secrets
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/live
